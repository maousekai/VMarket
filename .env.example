# ============================================================
# VMarket - Bien cau hinh Docker Compose (ha tang chung)
# Copy:  cp .env.example .env  (hoac copy bang tay) roi dieu chinh
# theo may cua ban. File .env khong duoc commit (da nam trong .gitignore).
#
# NGUON SU THAT: file nay (sau khi copy thanh .env) la nguon DUY NHAT cho
# `docker compose up`. Cac file services/<svc>/.env.example phuc vu mot cach
# chay KHAC (docker run --env-file / nap bien trong IDE) va KHONG duoc compose
# doc. Sua cau hinh cho cach chay nao thi sua dung file cua cach chay do.
#
# BIEN TRUNG O CA HAI HE - doi o day thi PHAI doi ca services/<svc>/.env*:
#   POSTGRES_USER / POSTGRES_PASSWORD  -> DB_USERNAME / DB_PASSWORD
#   RABBITMQ_USERNAME / RABBITMQ_PASSWORD
#   CORS_ALLOWED_ORIGINS               -> CORS_ALLOWED_ORIGINS
#                                         (api-gateway: APP_CORS_ALLOWED_ORIGINS)
#   AUTH_JWT_SECRET / AUTH_JWT_ACCESS_TTL / AUTH_JWT_REFRESH_TTL
#
# Doi chieu tu dong (bao loi neu 2 he lech gia tri):  scripts\check-env.cmd
# ============================================================

# Ten Docker Compose project (ten network/volume se gan ten nay)
COMPOSE_PROJECT_NAME=vmarket

# ---- PostgreSQL (auth, user, shop, order, payment, delivery, review) ----
POSTGRES_HOST=postgres
# Port POSTGRES TRONG container (service chay trong docker compose dung)
POSTGRES_PORT=5432
# Port postgres publish ra MAY HOST (service chay local qua mvnw dung).
# Mac dinh 5433 de tranh xung dot voi PostgreSQL 18 cai local tren may.
POSTGRES_HOST_PORT=5433
POSTGRES_USER=vmarket
POSTGRES_PASSWORD=vmarket
# DB tao mac dinh khi khoi tao container lan dau (dung cho auth)
POSTGRES_DB=vmarket_auth

# Port publish ra MAY HOST cua auth-service container (8081 la port noi bo).
# Service nay da chay trong docker compose, khong can chay mvnw nua.
AUTH_SERVICE_PORT=8081

# ---- Auth Service - JWT (PBL6-41) ----
# Khoa bi mat ky JWT HS256 - TOI THIEU 32 byte. Dev dung gia tri gia duoi day;
# PROD BAT BUOC doi thanh chuoi ngau nhien manh va KHONG commit.
# Khi API Gateway verify JWT (PBL6-46) se dung CHUNG dung secret nay.
AUTH_JWT_SECRET=dev-only-insecure-secret-change-me-please-0123456789
# Thoi han access token (SRS NFR-SEC-02: <= 30 phut). Dinh dang Duration cua Spring.
AUTH_JWT_ACCESS_TTL=15m
# Thoi han refresh token.
AUTH_JWT_REFRESH_TTL=15d

# ---- Auth Service - OTP xac thuc email (PBL6-44) ----
# provider=log: chi ghi log, KHONG gui email that (dev/CI, khong can API key).
# provider=brevo: goi Brevo HTTP API, can BREVO_API_KEY.
# PROD BAT BUOC dat "brevo" + BREVO_API_KEY. De "log" o prod se lam auth-service
# tu choi khoi dong (fail-fast, xem LogEmailSender).
AUTH_EMAIL_PROVIDER=log
AUTH_EMAIL_FROM=no-reply@vmarket.local
AUTH_EMAIL_FROM_NAME=VMarket
BREVO_API_KEY=
# Hieu luc OTP / so lan nhap sai toi da / chan resend / tran mo moi gio (Duration Spring).
AUTH_OTP_TTL=5m
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN=60s
AUTH_OTP_HOURLY_LIMIT=5

# ---- MongoDB (product, notification, chatbot) ----
MONGO_HOST=mongo
# Port MONGO TRONG container (service chay trong docker compose dung)
MONGO_PORT=27017
# Port mongo publish ra MAY HOST (service chay local qua mvnw dung).
# Mac dinh 27018 de tranh xung dot voi mongod cai local tren may.
MONGO_HOST_PORT=27018

# ---- Redis (cart, delivery, recommendation cache) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- RabbitMQ (event bus giua cac service) ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# Management UI: http://localhost:15672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---- Elasticsearch (profile "search" - AI Search) ----
ELASTICSEARCH_PORT=9200

# ---- API Gateway & Frontend (FE ket noi BE) ----
# Host chua cac business service ma API Gateway goi toi:
#  - host.docker.internal : business service chay tren may host (mvnw spring-boot:run)
#  - <ten-service>        : khi business service chay trong docker compose
BACKEND_SERVICES_HOST=host.docker.internal
# Port publish cua API Gateway ra may host (browser goi: VITE_API_BASE_URL)
GATEWAY_PORT=8080
# Port publish cua Frontend ra may host (mo: http://localhost:5173)
FRONTEND_PORT=5173
# URL Gateway ma trinh duyet goi truc tiep (bake vao bundle khi build FE)
VITE_API_BASE_URL=http://localhost:8080
# Origin FE duoc phep goi API (phai trung voi FRONTEND_PORT o tren)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
