# Copy thanh .env.local (khong commit). Moi request di qua API Gateway.
# Android emulator: http://10.0.2.2:8080
# May that cung Wi-Fi: http://<IP-LAN-cua-may-chay-gateway>:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Địa chỉ web VMarket. Trên điện thoại thật, dùng IP LAN của máy chạy web thay localhost.
# Nginx hoặc Vite chuyển tiếp /api/delivery/ws để theo dõi đơn hàng.
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Tuỳ chọn khi reverse proxy WebSocket ở host khác. Mặc định dùng EXPO_PUBLIC_WEB_URL.
# EXPO_PUBLIC_DELIVERY_WS_ORIGIN=https://tracking.example.com
