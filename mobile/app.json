{
  "expo": {
    "name": "VMarket",
    "slug": "vmarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vmarket",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.vmarket.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "VMarket dùng camera để tìm sản phẩm bằng hình ảnh.",
        "NSPhotoLibraryUsageDescription": "VMarket cần truy cập ảnh để tìm sản phẩm, đổi ảnh đại diện và gửi minh chứng.",
        "NSLocationWhenInUseUsageDescription": "VMarket dùng vị trí để chia sẻ hành trình giao hàng với người mua."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vmarket.mobile",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "VMarket dùng camera để tìm sản phẩm bằng hình ảnh."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VMarket cần truy cập ảnh để tìm sản phẩm, đổi ảnh đại diện và gửi minh chứng."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VMarket dùng vị trí để chia sẻ hành trình giao hàng với người mua."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
