{
  "name": "vmarket-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "axios": "^1.21.1",
    "expo": "~58.1.0",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.22",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.23",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "doctor": "expo-doctor"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "prettier": "^3.10.1"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|expo-router|axios)"
    ],
    "testTimeout": 20000
  }
}
