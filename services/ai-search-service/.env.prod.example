APP_ENV=prod
ELASTICSEARCH_URL=http://elasticsearch:9200
SEARCH_INDEX_ALIAS=vmarket-products
PRODUCT_SERVICE_URL=http://product-service:8084
INTERNAL_API_KEY=
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
EVENT_QUEUE=ai-search.events.v2
CORS_ALLOWED_ORIGINS=
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ORIGIN=https://media.example.com
MINIO_BUCKET=vmarket-media
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
EMBEDDING_MODEL=mobilenet_v3_small
EMBEDDING_WEIGHTS_PATH=/app/models/mobilenet_v3_small.pth
EMBEDDING_WEIGHTS_SHA256=
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
LLM_ENABLED=true
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
ALLOW_EXTERNAL_QUERY_TEXT=false
LLM_TIMEOUT_MS=500
LLM_MAX_TOKENS=128
LLM_RESPONSE_FORMAT=json_object
LLM_REASONING_EFFORT=

SEARCH_DEPENDENCY_TIMEOUT_SECONDS=2
MINIO_SOCKET_TIMEOUT_SECONDS=1
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=5
SEARCH_SYNONYMS='["ao thun, ao phong","giay the thao, sneaker"]'
SEARCH_NAME_BOOST=3
SEARCH_PHRASE_BOOST=5
SEARCH_SYNONYM_BOOST=0.3
SEARCH_SALES_WEIGHT=0.1
SEARCH_RATING_WEIGHT=0.04
SEARCH_POPULARITY_CAP=2
