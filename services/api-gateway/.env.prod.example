# ============================================================
# VMarket - api-gateway: bien moi truong MOI TRUONG PROD
# ============================================================
# DAY LA FILE MAU - KHONG dien gia tri that roi commit.
# Gia tri that bom luc deploy tu GitHub Secrets / secret manager cua server.
#
# Khac biet chinh so voi dev (services/api-gateway/.env.example):
#   - SPRING_PROFILES_ACTIVE=prod
#   - URL service tro toi ten service that trong mang noi bo, khong localhost
#   - CORS chi cho domain FE that
# Gateway khong co CSDL rieng - bien cua no la DIA CHI cac service dich.
# ============================================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ---- URL cac service dich (ten service trong mang noi bo) ----
AUTH_SERVICE_URL=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8082
SHOP_SERVICE_URL=http://shop-service:8083
PRODUCT_SERVICE_URL=http://product-service:8084
CART_SERVICE_URL=http://cart-service:8085
ORDER_SERVICE_URL=http://order-service:8086
PAYMENT_SERVICE_URL=http://payment-service:8087
DELIVERY_SERVICE_URL=http://delivery-service:8088
REVIEW_SERVICE_URL=http://review-service:8089
NOTIFICATION_SERVICE_URL=http://notification-service:8090
AI_SEARCH_SERVICE_URL=http://ai-search-service:8100
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8101
CHATBOT_SERVICE_URL=http://chatbot-service:8102

# ---- CORS: domain FE that o prod (KHONG dung localhost) ----
APP_CORS_ALLOWED_ORIGINS=

# ---- JVM ----
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
