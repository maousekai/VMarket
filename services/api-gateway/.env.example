# ============================================================
# VMarket - api-gateway: bien moi truong MOI TRUONG DEV
# ============================================================
# Copy: cp services/api-gateway/.env.example services/api-gateway/.env
#
#   docker build -f services/api-gateway/Dockerfile -t vmarket-api-gateway .
#   docker run --env-file services/api-gateway/.env -p 8080:8080 vmarket-api-gateway
#
# NGUON SU THAT - repo CO Y giu 2 he file env, moi he phuc vu MOT cach chay:
#   - File NAY (services/api-gateway/.env) : chay RIENG LE gateway
#         docker run --env-file ...   hoac nap bien trong IDE
#   - .env O GOC repo                      : chay `docker compose up`
#         compose doc .env goc + anchor x-service-urls trong
#         docker-compose.yml. Compose KHONG BAO GIO doc file nay.
#   => Sua cau hinh cho cach chay nao thi sua DUNG file cua cach chay do.
#
# BIEN TRUNG O CA HAI HE - doi mot ben PHAI doi ca ben kia:
#   APP_CORS_ALLOWED_ORIGINS  <- CORS_ALLOWED_ORIGINS o .env goc
#   Danh sach *_SERVICE_URL   <- anchor x-service-urls (ghep tu
#                                BACKEND_SERVICES_HOST o .env goc)
#
# CO Y KHAC NHAU (khong phai lech): host trong cac URL - file nay tro
# localhost, con compose tro host.docker.internal / ten service trong network.
#
# Doi chieu tu dong (bao loi neu 2 he lech gia tri):  scripts\check-env.cmd
#
# Khac biet dev / prod: xem services/api-gateway/.env.prod.example
# Gateway khong co CSDL rieng - bien cua no la DIA CHI cac service dich.
# ============================================================

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---- URL cac service dich ----
# Service chay bang mvnw tren may host  -> http://localhost:<port>
# Service chay trong docker compose     -> http://<ten-service>:<port>
#   (khi gateway chay trong container ma service chay tren host:
#    dung http://host.docker.internal:<port>)
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
SHOP_SERVICE_URL=http://localhost:8083
PRODUCT_SERVICE_URL=http://localhost:8084
CART_SERVICE_URL=http://localhost:8085
ORDER_SERVICE_URL=http://localhost:8086
PAYMENT_SERVICE_URL=http://localhost:8087
DELIVERY_SERVICE_URL=http://localhost:8088
REVIEW_SERVICE_URL=http://localhost:8089
NOTIFICATION_SERVICE_URL=http://localhost:8090
AI_SEARCH_SERVICE_URL=http://localhost:8100
RECOMMENDATION_SERVICE_URL=http://localhost:8101
CHATBOT_SERVICE_URL=http://localhost:8102

# ---- CORS ----
# Ten bien theo relaxed binding cua Spring: APP_CORS_ALLOWED_ORIGINS
# tuong ung property app.cors.allowed-origins (doc boi config/CorsConfig).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ---- JVM ----
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
