# =============================================================================
# auth-service — KHUNG MÔI TRƯỜNG PROD (file mẫu, commit vào git)
# =============================================================================
# QUY TRÌNH:
#   1. Trên server triển khai:  cp .env.prod.example .env.prod
#   2. Điền các giá trị đánh dấu <<< ĐIỀN >>>
#   3. chmod 600 .env.prod
#   4. File .env.prod nằm trong .gitignore — TUYỆT ĐỐI KHÔNG commit.
#
# Trong pipeline CI/CD, các bí mật này lấy từ GitHub Secrets chứ không đọc file
# (xem .github/workflows/_reusable-springboot-service.yml).
#
# Khác biệt chính so với dev (xem application-prod.yml):
#   - ddl-auto: validate  (KHÔNG để Hibernate tự sửa schema production)
#   - show-sql: false, log INFO (NFR-SEC-06: không lộ dữ liệu trong log)
#   - Mọi bí mật bắt buộc có giá trị, không có default trong code
#
# THỨ TỰ ƯU TIÊN: `environment:` trong compose > `env_file` (file này) > default.
# docker-compose.prod.yml đặt DB_* / RABBITMQ_* qua `<<: *common-environment`
# (đọc từ `.env.prod` ở thư mục gốc), nên các dòng DB_* / RABBITMQ_* dưới đây
# BỊ GHI ĐÈ khi chạy bằng compose — giữ lại để file tự mô tả đủ và để dùng được
# với `docker run --env-file`. Bí mật hạ tầng thật điền ở `.env.prod` gốc; bí
# mật RIÊNG của service (AUTH_JWT_SECRET, MAIL_PASSWORD...) điền ở file này.
# =============================================================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# ---- PostgreSQL -------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vmarket_auth
DB_USERNAME=vmarket
DB_PASSWORD=                      # <<< ĐIỀN: mật khẩu mạnh, khác hẳn dev

# ---- RabbitMQ ---------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=vmarket
RABBITMQ_PASSWORD=                # <<< ĐIỀN (không dùng guest/guest ở prod)

# ---- CORS -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=             # <<< ĐIỀN: domain thật của FE, vd https://vmarket.example.com

# ---- JWT (NFR-SEC-02) -------------------------------------------------------
# BẮT BUỘC: profile prod KHÔNG có giá trị mặc định cho AUTH_JWT_SECRET
# (application.yml), thiếu biến này container sẽ không khởi động được.
AUTH_JWT_SECRET=                  # <<< ĐIỀN: openssl rand -base64 64
# Định dạng Duration của Spring, không phải số phút/ngày trần.
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_REFRESH_TTL=7d

# ---- Email giao dịch (FR-AUTH-01, FR-AUTH-04) -------------------------------
MAIL_HOST=                        # <<< ĐIỀN
MAIL_PORT=587
MAIL_USERNAME=                    # <<< ĐIỀN
MAIL_PASSWORD=                    # <<< ĐIỀN (app password, không phải mật khẩu tài khoản)
MAIL_FROM=no-reply@vmarket.example.com

# ---- Google OAuth (FR-AUTH-03) ----------------------------------------------
GOOGLE_CLIENT_ID=                 # <<< ĐIỀN
GOOGLE_CLIENT_SECRET=             # <<< ĐIỀN

# ---- Log --------------------------------------------------------------------
LOG_LEVEL=INFO

# ---- JVM (giới hạn RAM cho VPS nhỏ) -----------------------------------------
JAVA_OPTS=-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError
