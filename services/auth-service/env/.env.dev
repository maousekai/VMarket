# =============================================================================
# auth-service — MÔI TRƯỜNG DEV (commit vào git được: KHÔNG có bí mật thật)
# =============================================================================
# Giá trị khớp với hạ tầng trong docker-compose.yml. Dùng khi container
# auth-service chạy TRONG network `vmarket-network` (gọi nhau bằng tên service).
#
#   docker run --rm --network vmarket-network -p 8081:8081 \
#     --env-file services/auth-service/env/.env.dev vmarket-auth-service:local
#
# Nếu chạy service bằng mvnw TRÊN MÁY HOST (ngoài Docker) thì đổi:
#   DB_HOST=localhost   DB_PORT=5433      (port publish của postgres)
#   RABBITMQ_HOST=localhost
#
# THỨ TỰ ƯU TIÊN — đọc kỹ trước khi sửa file này:
#   `environment:` trong compose  >  `env_file` (file này)  >  default application.yml
# Khối `auth-service` trong docker-compose.yml đã đặt DB_* / RABBITMQ_* qua
# `<<: *common-environment`, nên KHI CHẠY BẰNG COMPOSE các giá trị DB_* /
# RABBITMQ_* dưới đây BỊ GHI ĐÈ và không có tác dụng. Chúng chỉ thực sự được
# dùng khi chạy `docker run --env-file ...` như ví dụ ở trên.
# => Sửa host/port/mật khẩu hạ tầng cho compose thì sửa ở `.env` gốc, không
#    phải ở đây. Các biến RIÊNG của service (AUTH_JWT_*, MAIL_*, LOG_LEVEL...)
#    thì ngược lại: file này là nguồn duy nhất.
# =============================================================================

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# ---- PostgreSQL -------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vmarket_auth
DB_USERNAME=vmarket
DB_PASSWORD=vmarket

# ---- RabbitMQ ---------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---- CORS -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ---- JWT (PBL6-41) ----------------------------------------------------------
# TÊN BIẾN phải khớp application.yml của auth-service: AUTH_JWT_* (KHÔNG phải
# JWT_*), và TTL dùng định dạng Duration của Spring (15m, 30d) chứ không phải
# số phút/ngày trần. Đặt sai tên = app đọc không ra = chết lúc khởi động ở prod.
# Khoá DEV cố định để cả nhóm cùng test được token của nhau. KHÔNG dùng ở prod.
AUTH_JWT_SECRET=vmarket-dev-only-secret-khong-dung-cho-production-0123456789
# NFR-SEC-02: access token <= 30 phút.
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_REFRESH_TTL=30d

# ---- Email (dev: chưa cấu hình SMTP thật, để trống là service vẫn chạy) -----
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@vmarket.local

# ---- Google OAuth (dev: điền khi làm FR-AUTH-03) ----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Log --------------------------------------------------------------------
LOG_LEVEL=DEBUG
