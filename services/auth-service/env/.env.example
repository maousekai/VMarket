# =============================================================================
# auth-service — DANH MỤC ĐẦY ĐỦ BIẾN MÔI TRƯỜNG (file mẫu, commit vào git)
# =============================================================================
# File này là "hợp đồng cấu hình" của service: liệt kê MỌI biến service đọc,
# kèm ý nghĩa. KHÔNG chứa giá trị thật.
#
# Dùng thế nào:
#   - Chạy dev  : đã có sẵn env/.env.dev, không cần làm gì.
#   - Chạy prod : cp env/.env.prod.example env/.env.prod rồi điền giá trị thật.
#                 (.env.prod nằm trong .gitignore — TUYỆT ĐỐI không commit.)
#   - Thêm biến mới: thêm vào ĐÂY trước, rồi mới thêm vào .env.dev/.env.prod.
# =============================================================================

# ---- Định danh & cổng -------------------------------------------------------
# Profile Spring: dev | prod (quyết định application-<profile>.yml nào được nạp)
SPRING_PROFILES_ACTIVE=
# Cổng service lắng nghe bên trong container (auth-service = 8081)
SERVER_PORT=

# ---- PostgreSQL (SRS §7.1: Auth dùng PostgreSQL) ----------------------------
# Trong docker network: postgres | Chạy local bằng mvnw: localhost
DB_HOST=
# Trong container: 5432 | Từ máy host: 5433 (xem POSTGRES_HOST_PORT ở .env gốc)
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ---- RabbitMQ (Event Bus — SRS §8.1) ----------------------------------------
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# ---- CORS -------------------------------------------------------------------
# Danh sách origin của FE được phép gọi, phân tách bằng dấu phẩy
CORS_ALLOWED_ORIGINS=

# ---- JWT (FR-AUTH-02, FR-AUTH-06, NFR-SEC-02) -------------------------------
# BÍ MẬT — chỉ đặt giá trị thật ở GitHub Secrets / .env.prod trên server.
# Sinh khoá: openssl rand -base64 64
# BẮT BUỘC ở profile prod: application.yml khai ${AUTH_JWT_SECRET} KHÔNG có giá
# trị mặc định, thiếu biến này container chết ngay lúc khởi động.
AUTH_JWT_SECRET=
# Định dạng Duration của Spring: 15m, 2h, 30d (NFR-SEC-02: access <= 30 phút)
AUTH_JWT_ACCESS_TTL=
AUTH_JWT_REFRESH_TTL=

# ---- Email xác thực tài khoản / quên mật khẩu (FR-AUTH-01, FR-AUTH-04) ------
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---- Đăng nhập Google OAuth 2.0 (FR-AUTH-03) --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Log --------------------------------------------------------------------
# NFR-SEC-06: không bao giờ log mật khẩu / token. Prod dùng INFO trở lên.
LOG_LEVEL=

# ---- JVM --------------------------------------------------------------------
# Ghi đè JAVA_OPTS mặc định trong Dockerfile nếu cần (thường để trống)
JAVA_OPTS=
