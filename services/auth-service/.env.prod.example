# ============================================================
# VMarket - auth-service: bien moi truong MOI TRUONG PROD (mau)
# ============================================================
# DAY LA FILE MAU - gia tri nhay cam de TRONG co chu y.
# TUYET DOI KHONG dien mat khau / secret that vao file nay roi commit.
#
# Cach dung dung: gia tri that duoc bom luc deploy tu GitHub Secrets /
# secret manager cua server, khong luu trong repo.
#   docker run --env-file /etc/vmarket/auth-service.env -p 8081:8081 vmarket-auth-service
#
# Khac biet chinh so voi dev (xem services/auth-service/.env.example):
#   - SPRING_PROFILES_ACTIVE=prod  -> nap application-prod.yml
#     (tat show-sql, log INFO, khong co gia tri mac dinh cho host/secret
#      => THIEU BIEN LA FAIL NGAY LUC KHOI DONG, khong am tham chay sai)
#   - Host tro toi ha tang that, khong con localhost
#   - Khong co gia tri mac dinh cho mat khau
# ============================================================

# BAT BUOC = prod. Day la cong tac tach cau hinh dev/prod.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# ---- PostgreSQL (BAT BUOC - khong co gia tri mac dinh o profile prod) ----
DB_HOST=
DB_PORT=5432
DB_NAME=vmarket_auth
DB_USERNAME=
DB_PASSWORD=

# ---- RabbitMQ (BAT BUOC) ----
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# ---- JWT (BAT BUOC) ----
# KHONG co gia tri mac dinh o prod: thieu bien nay service FAIL ngay luc
# khoi dong (@Validated @NotBlank tren AuthJwtProperties) - co y de khong
# bao gio chay prod bang secret dev.
# Sinh khoa moi:  openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_REFRESH_TTL=15d

# ---- CORS: domain FE that o prod (KHONG dung localhost) ----
CORS_ALLOWED_ORIGINS=

# ---- JVM ----
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
