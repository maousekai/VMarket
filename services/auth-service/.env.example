# ============================================================
# VMarket - auth-service: bien moi truong MOI TRUONG DEV (local)
# ============================================================
# Copy roi chinh theo may cua ban:
#   cp services/auth-service/.env.example services/auth-service/.env
# File .env KHONG duoc commit (da chan trong .gitignore).
#
# DUNG KHI NAO:
#   - Chay container rieng le cua service nay:
#       docker build -f services/auth-service/Dockerfile -t vmarket-auth-service .
#       docker run --env-file services/auth-service/.env -p 8081:8081 vmarket-auth-service
#   - Nap bien khi chay bang IDE / plugin doc .env
#
# KHI CHAY BANG DOCKER COMPOSE o goc repo thi compose lay bien tu .env O GOC
# (anchor x-common-environment trong docker-compose.yml), khong doc file nay.
#
# Khac biet dev / prod: xem services/auth-service/.env.prod.example
# ============================================================

# Profile Spring: quyet dinh doc them application-dev.yml hay application-prod.yml
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# ---- PostgreSQL ----
# 5433 la port docker compose publish ra MAY HOST (tranh dung PostgreSQL cai
# san tren may). Chay TRONG container cung network thi dat DB_HOST=postgres
# va DB_PORT=5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=vmarket_auth
DB_USERNAME=vmarket
DB_PASSWORD=vmarket

# ---- RabbitMQ (event bus giua cac service) ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---- JWT (PBL6-41/43) ----
# Khoa ky JWT HS256, TOI THIEU 32 ky tu. Dev dung gia tri gia duoi day.
# API Gateway khi verify JWT phai dung CHUNG dung secret nay.
AUTH_JWT_SECRET=dev-only-insecure-secret-change-me-please-0123456789
# TTL access token (SRS NFR-SEC-02: <= 30 phut)
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_REFRESH_TTL=15d

# ---- CORS: origin cua FE duoc phep goi API ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ---- JVM ----
# MaxRAMPercentage de JVM ton trong gioi han RAM cua container (mem_limit)
# thay vi nhin RAM cua ca may host.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
