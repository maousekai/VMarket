# ============================================================
# VMarket - product-service: bien moi truong MOI TRUONG DEV (local)
# ============================================================
# Copy roi chinh theo may cua ban:
#   cp services/product-service/.env.example services/product-service/.env
# File .env KHONG duoc commit (da chan trong .gitignore).
#
# DUNG KHI NAO:
#   - Chay container rieng le cua service nay:
#       docker build -f services/product-service/Dockerfile -t vmarket-product-service .
#       docker run --env-file services/product-service/.env -p 8084:8084 vmarket-product-service
#   - Nap bien khi chay bang IDE / plugin doc .env
#
# NGUON SU THAT - repo CO Y giu 2 he file env, moi he phuc vu MOT cach chay:
#   - File NAY (services/<svc>/.env) : chay RIENG LE mot service
#         docker run --env-file ...   hoac nap bien trong IDE
#   - .env O GOC repo                 : chay `docker compose up`
#         compose doc .env goc + anchor x-common-environment trong
#         docker-compose.yml. Compose KHONG BAO GIO doc file nay.
#   => Sua cau hinh cho cach chay nao thi sua DUNG file cua cach chay do.
#
# BIEN TRUNG O CA HAI HE - doi mot ben PHAI doi ca ben kia:
#   DB_USERNAME / DB_PASSWORD            <- POSTGRES_USER / POSTGRES_PASSWORD
#   RABBITMQ_USERNAME / RABBITMQ_PASSWORD
#   CORS_ALLOWED_ORIGINS
#   AUTH_JWT_SECRET / AUTH_JWT_*_TTL     (rieng auth-service)
#
# CO Y KHAC NHAU (khong phai lech): DB_HOST / MONGO_HOST / REDIS_HOST va cac
# PORT ha tang - file nay tro localhost:<port publish ra host>, con compose tro
# <ten-service>:<port noi bo trong network>.
#
# Doi chieu tu dong (bao loi neu 2 he lech gia tri):  scripts\check-env.cmd
#
# Khac biet dev / prod: xem services/product-service/.env.prod.example
# ============================================================

# Profile Spring: quyet dinh doc them application-dev.yml hay application-prod.yml
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8084

# ---- MongoDB ----
# 27018 la port docker compose publish ra MAY HOST. Chay TRONG container cung
# network thi dat MONGO_HOST=mongo va MONGO_PORT=27017.
MONGO_HOST=localhost
MONGO_PORT=27018
# DB_NAME (khong phai MONGO_DB): ten bien CHUNG cho moi loai CSDL trong repo -
# service Postgres va service Mongo deu doc DB_NAME, khop voi anchor
# x-common-environment / block service trong docker-compose.yml.
DB_NAME=vmarket_product

# ---- RabbitMQ (event bus giua cac service) ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---- CORS: origin cua FE duoc phep goi API ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ---- JVM ----
# MaxRAMPercentage de JVM ton trong gioi han RAM cua container (mem_limit)
# thay vi nhin RAM cua ca may host.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
