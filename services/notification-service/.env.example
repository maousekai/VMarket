# ============================================================
# VMarket - notification-service: bien moi truong MOI TRUONG DEV (local)
# ============================================================
# Copy roi chinh theo may cua ban:
#   cp services/notification-service/.env.example services/notification-service/.env
# File .env KHONG duoc commit (da chan trong .gitignore).
#
# DUNG KHI NAO:
#   - Chay container rieng le cua service nay:
#       docker build -f services/notification-service/Dockerfile -t vmarket-notification-service .
#       docker run --env-file services/notification-service/.env -p 8090:8090 vmarket-notification-service
#   - Nap bien khi chay bang IDE / plugin doc .env
#
# KHI CHAY BANG DOCKER COMPOSE o goc repo thi compose lay bien tu .env O GOC
# (anchor x-common-environment trong docker-compose.yml), khong doc file nay.
#
# Khac biet dev / prod: xem services/notification-service/.env.prod.example
# ============================================================

# Profile Spring: quyet dinh doc them application-dev.yml hay application-prod.yml
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8090

# ---- MongoDB ----
# 27018 la port docker compose publish ra MAY HOST. Chay TRONG container cung
# network thi dat MONGO_HOST=mongo va MONGO_PORT=27017.
MONGO_HOST=localhost
MONGO_PORT=27018
DB_NAME=vmarket_notification

# ---- RabbitMQ (event bus giua cac service) ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---- CORS: origin cua FE duoc phep goi API ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ---- JVM ----
# MaxRAMPercentage de JVM ton trong gioi han RAM cua container (mem_limit)
# thay vi nhin RAM cua ca may host.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
