# Chatbot service - chay rieng le (uvicorn / docker run --env-file). docker compose KHONG doc file nay.
# AUTH_JWT_SECRET, CORS_ALLOWED_ORIGINS, INTERNAL_API_KEY phai TRUNG .env.example o goc (scripts\check-env.cmd).
APP_ENV=dev

# ---- MongoDB (Conversation, Message, KnowledgeChunk, SupportTicket) ----
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DIRECT_CONNECTION=true
DB_NAME=vmarket_chatbot
MONGO_TIMEOUT_SECONDS=3

# ---- Xac thuc: verify access token do auth-service ky (HS256) ----
AUTH_JWT_SECRET=dev-only-insecure-secret-change-me-please-0123456789
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ---- FR-BOT-02: tra cuu don hang (chuyen tiep token cua chinh nguoi hoi) ----
ORDER_SERVICE_URL=http://localhost:8086
ORDER_TIMEOUT_SECONDS=3

# ---- Nap catalog vao kho tri thuc: python manage.py ingest --catalog ----
PRODUCT_SERVICE_URL=http://localhost:8084
INTERNAL_API_KEY=dev-only-internal-api-key-change-me-0123456789

# ---- LLM (OpenAI-compatible). De trong = che do trich dan (khong sinh van ban) ----
LLM_ENABLED=true
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# true = cho phep gui cau hoi + ngu canh kho tri thuc toi nha cung cap ben ngoai.
ALLOW_EXTERNAL_QUERY_TEXT=false
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=512

# ---- Truy hoi (retrieval) ----
# hashing = vector tu vung, chay offline. openai_compatible = goi LLM_BASE_URL/embeddings.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=10
RETRIEVAL_TOP_K=4
# Nguong cosine da hieu chinh cho "hashing"; doi embedding phai hieu chinh lai.
RETRIEVAL_MIN_SCORE=0.25
KNOWLEDGE_REFRESH_SECONDS=60
CHAT_HISTORY_TURNS=3
SUPPORT_CONTACT=mục Hỗ trợ trên VMarket
