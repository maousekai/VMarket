# Copy file nay thanh .env khi chay `npm run dev`.

# Base URL cua API. DE TRONG (mac dinh) = goi `/api/...` cung origin voi trang:
#   - `npm run dev`      : Vite dev server proxy /api -> VITE_DEV_API_PROXY
#   - chay bang Docker   : nginx proxy /api -> api-gateway:8080
# Cung origin nen KHONG dinh CORS. Chi dien URL tuyet doi (vd http://localhost:8080)
# khi that su can goi thang gateway - luc do gateway phai cho phep origin cua FE.
VITE_API_BASE_URL=

# Dich ma Vite dev server chuyen tiep `/api` toi (chi co tac dung khi `npm run dev`,
# khong anh huong ban build production). Mac dinh la gateway publish ra may host.
VITE_DEV_API_PROXY=http://localhost:8080
