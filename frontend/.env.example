# Copy file nay thanh .env (chi can khi muon doi mac dinh).
#
# Dich den cua proxy /api khi chay `npm run dev` (vite dev server).
VITE_DEV_API_TARGET=http://localhost:8080
#
# Base URL cua API: DE RONG de goi duong dan tuong doi (/api/...) ve cung
# origin - dev thi vite proxy, docker thi nginx reverse proxy chuyen tiep sang
# API Gateway. Chi dien gia tri khi co chu dinh goi THANG Gateway o origin khac
# (vd http://localhost:8080), luc do BE phai bat CORS cho origin cua FE.
VITE_API_BASE_URL=
