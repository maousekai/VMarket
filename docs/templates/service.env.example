# ============================================================
# VMarket - TEMPLATE .env cho MOI TRUONG DEV cua mot service
# ============================================================
# CACH DUNG:
#   1. Copy thanh services/__SERVICE__/.env.example
#   2. Thay __SERVICE__ / __PORT__ / __DB_NAME__
#   3. XOA khoi ha tang khong dung (service dung Postgres thi xoa khoi
#      MongoDB va Redis, va nguoc lai)
# Hoac chay: scripts\new-service.ps1 -Name __SERVICE__ -Port __PORT__
#
# File .env THAT (khong co duoi .example) KHONG BAO GIO duoc commit.
#
# NGUON SU THAT - repo CO Y giu 2 he file env, moi he phuc vu MOT cach chay:
#   - services/<svc>/.env : chay RIENG LE mot service
#         docker run --env-file ...   hoac nap bien trong IDE
#   - .env O GOC repo     : chay `docker compose up`
#         compose doc .env goc + anchor x-common-environment trong
#         docker-compose.yml. Compose KHONG BAO GIO doc file cua service.
#   => Sua cau hinh cho cach chay nao thi sua DUNG file cua cach chay do.
#
# BIEN TRUNG O CA HAI HE - doi mot ben PHAI doi ca ben kia:
#   DB_USERNAME / DB_PASSWORD            <- POSTGRES_USER / POSTGRES_PASSWORD
#   RABBITMQ_USERNAME / RABBITMQ_PASSWORD
#   CORS_ALLOWED_ORIGINS
#
# CO Y KHAC NHAU (khong phai lech): DB_HOST / MONGO_HOST / REDIS_HOST va cac
# PORT ha tang - file service tro localhost:<port publish ra host>, con compose
# tro <ten-service>:<port noi bo trong network>.
#
# Doi chieu tu dong (bao loi neu 2 he lech gia tri):  scripts\check-env.cmd
# ============================================================

# Profile Spring: quyet dinh doc them application-dev.yml hay application-prod.yml
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=__PORT__

# ---- PostgreSQL (xoa khoi nay neu service khong dung Postgres) ----
# 5433 = port compose publish ra MAY HOST. Trong container: postgres:5432
DB_HOST=localhost
DB_PORT=5433
DB_NAME=__DB_NAME__
DB_USERNAME=vmarket
DB_PASSWORD=vmarket

# ---- MongoDB (xoa khoi nay neu service khong dung Mongo) ----
# 27018 = port compose publish ra MAY HOST. Trong container: mongo:27017
MONGO_HOST=localhost
MONGO_PORT=27018
# DB_NAME (khong phai MONGO_DB): ten bien CHUNG cho moi loai CSDL trong repo -
# service Postgres va service Mongo deu doc DB_NAME, khop voi anchor
# x-common-environment / block service trong docker-compose.yml.
DB_NAME=__DB_NAME__

# ---- Redis (xoa khoi nay neu service khong dung Redis) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- RabbitMQ (event bus giua cac service) ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---- CORS: origin cua FE duoc phep goi API ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ---- JVM ----
# MaxRAMPercentage de JVM ton trong gioi han RAM cua container (mem_limit)
# thay vi nhin RAM cua ca may host.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
