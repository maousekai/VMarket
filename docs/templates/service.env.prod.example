# ============================================================
# VMarket - TEMPLATE .env cho MOI TRUONG PROD cua mot service
# ============================================================
# CACH DUNG: copy thanh services/__SERVICE__/.env.prod.example,
# thay __SERVICE__ / __PORT__ / __DB_NAME__, xoa khoi ha tang khong dung.
#
# DAY LA FILE MAU: gia tri nhay cam de TRONG.
# TUYET DOI KHONG dien mat khau / secret that vao roi commit.
# Gia tri that duoc bom luc deploy tu GitHub Secrets / secret manager.
#
# NGUYEN TAC TACH DEV/PROD trong repo nay:
#   - dev : application-dev.yml co gia tri mac dinh -> clone repo la chay duoc
#   - prod: application-prod.yml KHONG co gia tri mac dinh cho host/secret
#           -> thieu bien la service FAIL NGAY LUC KHOI DONG. Co y nhu vay,
#              de khong bao gio chay prod bang mat khau dev.
# ============================================================

# BAT BUOC = prod. Day la cong tac tach cau hinh dev/prod.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=__PORT__

# ---- PostgreSQL (BAT BUOC neu service dung Postgres) ----
DB_HOST=
DB_PORT=5432
DB_NAME=__DB_NAME__
DB_USERNAME=
DB_PASSWORD=

# ---- MongoDB (BAT BUOC neu service dung Mongo) ----
MONGO_HOST=
MONGO_PORT=27017
# DB_NAME (khong phai MONGO_DB): ten bien CHUNG cho moi loai CSDL trong repo -
# service Postgres va service Mongo deu doc DB_NAME, khop voi anchor
# x-common-environment / block service trong docker-compose.yml.
DB_NAME=__DB_NAME__

# ---- Redis (BAT BUOC neu service dung Redis) ----
REDIS_HOST=
REDIS_PORT=6379

# ---- RabbitMQ (BAT BUOC) ----
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# ---- CORS: domain FE that o prod (KHONG dung localhost) ----
CORS_ALLOWED_ORIGINS=

# ---- JVM ----
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
