# Build artifacts (phòng thủ nhiều lớp cùng .gitignore từng service)
node_modules/
target/
dist/
build/
__pycache__/
*.pyc
.venv/

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
.factorypath

# OS
.DS_Store
Thumbs.db

# Logs
*.log
log_*_*.txt
logs_*.txt

# Environment variables (giu cac file *.example trong repo)
# Chan CA .env.prod / .env.staging... de khong lo commit secret that;
# chi cac file .example (khong chua gia tri that) moi duoc commit.
.env
.env.*
!.env.example
!.env.*.example

# Docker
docker-compose.override.yml
