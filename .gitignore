# Build artifacts (phòng thủ nhiều lớp cùng .gitignore từng service)
node_modules/
target/
dist/
build/
__pycache__/
*.pyc
.venv/

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
.factorypath

# OS
.DS_Store
Thumbs.db

# Logs
*.log
log_*_*.txt
logs_*.txt

# Environment variables (giu .env.example trong repo)
.env
.env.local
.env.*.local
!.env.example

# Cau hinh .env theo tung service (PBL6-CICD):
#   .env.dev          -> COMMIT (chi gia tri dev, khong co bi mat that)
#   .env.prod.example -> COMMIT (khung, gia tri de trong)
#   .env.prod         -> KHONG BAO GIO commit (chua bi mat that)
services/*/env/.env.prod
services/*/env/.env.*.local
**/.env.prod
!**/.env.prod.example

# Docker
docker-compose.override.yml
